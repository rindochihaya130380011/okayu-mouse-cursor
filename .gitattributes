import zipfile, shutil, os

zip_path = "/mnt/data/animated_cursor_package.zip"
img_src = "/mnt/data/okayucursor.2_MM_24_4_8_5_F_1.5_WW_.2.png"
img_dst_name = "okayucursor.png"

index_html = """<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Animated Cursor</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Custom Animated Cursor Demo</h1>
    <script src="cursor.js"></script>
</body>
</html>
"""

style_css = """body {
    cursor: none;
}

#animated-cursor {
    position: fixed;
    width: 32px;
    height: 32px;
    pointer-events: none;
    image-rendering: pixelated;
    background-image: url("okayucursor.png");
    background-repeat: no-repeat;
    background-size: calc(32px * 8) 32px;
}
"""

cursor_js = """const frameWidth = 32;
const frameCount = 8;
const fps = 8;

const cursor = document.createElement("div");
cursor.id = "animated-cursor";
document.body.appendChild(cursor);

document.addEventListener("mousemove", e => {
    cursor.style.left = e.clientX + "px";
    cursor.style.top = e.clientY + "px";
});

let currentFrame = 0;
setInterval(() => {
    cursor.style.backgroundPosition = `-${currentFrame * frameWidth}px 0px`;
    currentFrame = (currentFrame + 1) % frameCount;
}, 1000 / fps);
"""

with zipfile.ZipFile(zip_path, 'w') as z:
    z.writestr("index.html", index_html)
    z.writestr("style.css", style_css)
    z.writestr("cursor.js", cursor_js)
    z.write(img_src, img_dst_name)

zip_path
